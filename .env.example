# Copy this file to .env and fill in your key.
# Default provider is Groq (free tier): create a key at console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here

# Optional — only set these to switch provider or model without touching code.
# Each service has its own model, because Groq counts free daily tokens per model.
# LLM_BASE_URL=https://api.groq.com/openai/v1
# STUDY_BUDDY_MODEL=openai/gpt-oss-20b
# MAKAN_ADVISOR_MODEL=openai/gpt-oss-120b
